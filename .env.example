# CBE Savings Account Demo — environment template
# Copy to .env and fill in your values.
# Never commit .env to git.

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cbe_savings
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# For SQLite (set DB_DRIVER=sqlite to use this instead)
# DB_SQLITE_PATH=database/data.sqlite
